# [ Global Config ]
max-history=5
sort=+time

# [ BINDING OPTIONS ]
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# [ STYLE OPTIONS ]
font=Iosevka NFM 11
background-color=#1e1e2ec2
text-color=#cdd6f4
width=380
padding=12
margin=0
outer-margin=12
border-size=1
border-color=#cdd6f414
border-radius=0
progress-color=over #cdd6f412

# Icons
icons=1
max-icon-size=36
icon-location=left

# Behavior
actions=1
history=1
markup=1
text-alignment=left

format=<span foreground="#74c7ec">%a</span>  <span foreground="#b4befe"><b>%s</b></span>\n<span foreground="#bac2de">%b</span>

default-timeout=8000
ignore-timeout=0

max-visible=5
layer=top
anchor=top-right

# [ PER-URGENCY OVERRIDES ]
[urgency=low]
border-color=#74c7ec4d
text-color=#bac2de

[urgency=normal]
border-color=#b4befe66

[urgency=critical]
border-color=#f38ba899
background-color=#1e1e2ee0
default-timeout=0
format=<span foreground="#f38ba8">%a</span>  <span foreground="#f38ba8"><b>%s</b></span>\n<span foreground="#cdd6f4">%b</span>
